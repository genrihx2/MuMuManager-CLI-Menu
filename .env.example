# Archil disk storage (server-side only).
# Copy this file to .env (gitignored) and fill in ARCHIL_API_KEY.

# Archil API key from https://console.archil.com/api-keys.
# It starts with "key-". A disk/mount token (often "adt_…") is a different
# credential and gets HTTP 401 from the API.
ARCHIL_API_KEY=

# Region the API key was created in (keys are region-scoped). Defaults to
# aws-us-east-1 when unset. Exec works only in aws-us-east-1, aws-us-west-2 and
# aws-eu-west-1.
ARCHIL_REGION=aws-us-east-1

# Id of the disk to persist files on (e.g. dsk-…). Leave empty to let
# `npm run check:archil` create a disk.
ARCHIL_DISK_ID=
